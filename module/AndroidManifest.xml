<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.eage9.nicehckbridge"
    android:versionCode="2"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />


    <queries>
        <package android:name="com.yuandao.nicehck" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:description="@string/module_description"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="io.github.eage9.nicehckbridge.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
        android:description="@string/module_description">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="io.github.eage9.nicehckbridge.CmdProvider"
            android:authorities="io.github.eage9.nicehckbridge.cmd"
            android:exported="true" />

        <receiver
            android:name="io.github.eage9.nicehckbridge.StateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.eage9.nicehckbridge.STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="io.github.eage9.nicehckbridge.CmdReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.eage9.nicehckbridge.CMD" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="io.github.eage9.nicehckbridge.NoiseWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nicehck_widget_info" />
        </receiver>

        <service
            android:name="io.github.eage9.nicehckbridge.dss.ConfigService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.eage9.nicehckbridge.dss.CONFIG" />
            </intent-filter>
        </service>

        <service
            android:name="io.github.eage9.nicehckbridge.dss.SettingsService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.eage9.nicehckbridge.dss.SETTINGS" />
            </intent-filter>
        </service>

        <service
            android:name="io.github.eage9.nicehckbridge.NoiseControlTile"
            android:exported="true"
            android:icon="@android:drawable/ic_lock_silent_mode_off"
            android:label="原道降噪"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

    </application>
</manifest>
